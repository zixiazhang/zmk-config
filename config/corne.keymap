#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// LAYERS

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUNC    3

// MACROS

#define SUPER LC(LSHIFT)
#define SUPER2 LA(LC(LSHIFT))

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&hm RGUI SEMI>, <&kp SQT>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LCTRL TAB>, <&kp ESC>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_cword {
            timeout-ms = <50>;
            key-positions = <19 16>;
            bindings = <&caps_word>;
        };

        combo_vimwq {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&vim_quit>;
        };
    };

    macros {
        vim_quit: vim_quit {
            label = "ZM_vim_quit";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp ESC &kp COLON &kp W &kp Q>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none  &kp Q       &kp W       &kp E        &kp R         &kp T        &kp Y      &kp U            &kp I        &kp O       &kp P               &none
&none  &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHIFT F  &kp G        &kp H      &hm RSHIFT J     &hm RCTRL K  &hm RALT L  &hm RGUI SEMICOLON  &none
&none  &kp Z       &kp X       &kp C        &kp V         &kp B        &kp N      &kp M            &kp COMMA    &kp DOT     &kp FSLH            &none
                               &kp ESC      &lt 1 SPACE   &lt 2 TAB    &lt 4 RET  &lt 3 BACKSPACE  &kp DELETE
            >;
        };

        nav_layer {
            bindings = <
&none  &kp LC(LS(LG(NUMBER_4)))  &kp HOME   &kp UP      &kp END      &kp PG_UP            &none      &none            &none       &none          &none          &none
&none  &kp K_REDO                &kp LEFT   &kp DOWN    &kp RIGHT    &kp PG_DN            &none      &kp RIGHT_SHIFT  &kp RCTRL   &kp RIGHT_ALT  &kp RIGHT_GUI  &none
&none  &kp K_UNDO                &kp K_CUT  &kp K_COPY  &kp K_PASTE  &kp LS(LA(LG(V)))    &none      &none            &none       &none          &none          &none
                                            &none       &none        &none                &kp ENTER  &kp BACKSPACE    &kp DELETE
            >;
        };

        mac_layer {
            bindings = <
&none  &none  &none         &kp LC(UP_ARROW)    &none          &none    &none  &none     &none  &none       &none  &none
&none  &none  &kp LC(LEFT)  &kp LC(DOWN_ARROW)  &kp LC(RIGHT)  &none    &none  &kp CLCK  &none  &kp K_LOCK  &none  &none
&none  &none  &none         &none               &none          &none    &none  &none     &none  &none       &none  &none
                            &none               &none          &none    &none  &none     &none
            >;
        };

        num_layer {
            bindings = <
&none  &kp GRAVE      &kp N7        &kp N8        &kp N9        &kp EQUAL    &none           &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none            &none          &none
&none  &kp SQT        &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS     &none           &kp RIGHT_SHIFT       &kp RCTRL              &kp RIGHT_ALT    &kp RIGHT_GUI  &none
&none  &kp BACKSLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS    &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &none          &none
                                    &kp AT        &kp N0        &kp HASH     &none           &none                 &none
            >;
        };

        func_layer {
            bindings = <
&none  &none  &kp F7  &kp F8  &kp F9  &kp F12    &none         &kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP     &none       &none
&none  &none  &kp F4  &kp F5  &kp F6  &kp F11    &none         &kp C_REWIND  &kp C_PLAY_PAUSE   &kp C_FAST_FORWARD  &kp C_STOP  &none
&none  &none  &kp F1  &kp F2  &kp F3  &kp F10    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_NXT          &bt BT_CLR  &none
                      &none   &none   &none      &none         &none         &none
            >;
        };
    };
};
